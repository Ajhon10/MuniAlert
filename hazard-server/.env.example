APP_NAME=MuniAlert
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URLS=http://localhost:5173,http://127.0.0.1:5173,https://localhost,capacitor://localhost
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=municipal_hazards
DB_USERNAME=root
DB_PASSWORD=

# Optional local demo accounts. Set three distinct passwords before running DemoAccountSeeder.
HAZARD_DEMO_ADMIN_PASSWORD=
HAZARD_DEMO_CITIZEN_ONE_PASSWORD=
HAZARD_DEMO_CITIZEN_TWO_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=129600
SESSION_EXPIRE_ON_CLOSE=false
AUTH_SESSION_DAYS=90
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Local disk for development; set r2 for Cloudflare R2.
# Evidence must never use a public bucket or the public local disk.
HAZARD_EVIDENCE_DISK=evidence
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_PUBLIC_URL=
# Firebase service-account JSON stays on the server, outside public/.
FCM_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
# Hostinger Web/Cloud: enable bounded push batches through the scheduler cron.
# Keep false when running a separately supervised persistent worker.
HAZARD_SCHEDULED_PUSH=false

# Optional social sign-in: server-only OAuth credentials. See SOCIAL_AUTH_SETUP.md.
# Register these exact HTTPS callback URLs in each provider's app dashboard.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=
