# Web uses the Vite proxy in development and the same origin in production.
# For Capacitor Android, set the public HTTPS Laravel URL before building.
VITE_API_BASE_URL=
VITE_MUNICIPALITY=Basista Municipal Hall
# Optional MapLibre style URL. Default: OpenFreeMap Clear (Positron).
VITE_MAP_STYLE_URL=
VITE_MAP_CENTER_LAT=15.865448
VITE_MAP_CENTER_LNG=120.400132
# Optional replacements for bundled Basista / Pangasinan reference boundaries.
VITE_CITY_GEOJSON_URL=
VITE_PROVINCE_GEOJSON_URL=
VITE_BARANGAY_GEOJSON_URL=
VITE_EMERGENCY_PHONE=
# Optional Firebase web push configuration.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
