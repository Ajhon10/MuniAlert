{
  "name": "hazard-client",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "preview": "vite preview --host 0.0.0.0",
    "android:add": "cap add android",
    "android:sync": "npm run build && cap sync android",
    "android:run": "npm run build && cap run android",
    "android:open": "cap open android",
    "verify": "npm run typecheck && npm run build && npm audit --audit-level=moderate && npm run android:sync"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "7.1.3",
    "@capacitor/android": "^7.4.3",
    "@capacitor/app": "^7.1.2",
    "@capacitor/browser": "^7.0.5",
    "@capacitor/camera": "^7.0.2",
    "@capacitor/core": "^7.4.3",
    "@capacitor/geolocation": "^7.1.5",
    "@capacitor/push-notifications": "^7.0.3",
    "@lucide/vue": "^1.49.0",
    "firebase": "^12.4.0",
    "maplibre-gl": "^6.11.2",
    "qrcode": "^1.5.4",
    "vue": "^3.5.22"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3",
    "@types/node": "^22.18.0",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^6.0.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.2",
    "vue-tsc": "^3.1.1"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.7",
    "firebase": {
      "@grpc/grpc-js": "^1.14.7"
    }
  }
}
