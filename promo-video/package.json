{
  "name": "promo-video",
  "version": "1.0.0",
  "description": "MuniAlert promotional video and editable Remotion scenes",
  "repository": {},
  "license": "UNLICENSED",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.541",
    "@remotion/media": "4.0.541",
    "@remotion/transitions": "4.0.541",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.541"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.541",
    "@types/react": "19.3.0",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio --no-open --port=3030",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "typecheck": "tsc --noEmit",
    "render": "node scripts/render.mjs",
    "render:portrait": "node scripts/render.mjs --portrait",
    "render:landscape": "node scripts/render.mjs --landscape",
    "review": "node scripts/render.mjs --review",
    "verify:output": "node scripts/verify-output.mjs",
    "poster": "node scripts/render.mjs --poster",
    "capture": "node scripts/capture-ui.mjs",
    "music": "python scripts/generate-music.py"
  },
  "allowScripts": {
    "esbuild": false
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
