# Fill privately on Hostinger. This template contains no application credentials.
APP_NAME=MuniAlert
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://your-domain.example
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
LOG_CHANNEL=single
LOG_LEVEL=warning
BCRYPT_ROUNDS=12

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
SESSION_DRIVER=database
SESSION_LIFETIME=129600
SESSION_EXPIRE_ON_CLOSE=false
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=your-domain.example
FRONTEND_URLS=https://your-domain.example,https://localhost,capacitor://localhost
CACHE_STORE=database
QUEUE_CONNECTION=database
AUTH_PERSISTENT_LOGIN=true
AUTH_SESSION_DAYS=90
HAZARD_EVIDENCE_DISK=evidence
HAZARD_SCHEDULED_PUSH=false

MAIL_ENABLED=true
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_REQUIRE_TLS=true
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=MuniAlert
MAIL_TIMEOUT=15
SECURITY_RECOVERY_ENABLED=true
SECURITY_FRONTEND_URL=https://your-domain.example
PRIVACY_OPERATOR_NAME="BASISTA MUNICIPAL HALL"
PRIVACY_CONTACT_EMAIL=
SECURITY_EVENT_RETENTION_DAYS=30
SECURITY_MONITOR_ENABLED=true
SECURITY_FAILURE_ALERT_THRESHOLD=20
# Confirm a supported private scanner/service and signatures with the host before
# enabling this flag. The existing phase-2 security gate requires scanner setup.
SECURITY_SCAN_UPLOADS=false
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_TIMEOUT=3
# Optional integrations remain disabled until configured and verified.
IMAGE_DETECTOR_ENABLED=false
FCM_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_PUBLIC_URL=

# Initial administrator: sample identity for local setup; replace email in production.
INITIAL_ADMIN_NAME="Municipal Administrator"
INITIAL_ADMIN_EMAIL=admin@munialert.test
# Private unique password (12-72 bytes); never committed or logged.
INITIAL_ADMIN_PASSWORD=
