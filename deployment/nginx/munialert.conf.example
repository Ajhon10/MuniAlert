# Adapt paths, PHP-FPM socket, server_name, and TLS configuration before use.
# Alternative VPS only; selected Hostinger Web/Cloud hosting is provider-managed.
# Pass deployment/nginx-security/check.php on a VPS before activation; see
# documentation/07-deployment-and-maintenance.md, NGINX security gate.
# Keep HTTP/2 and QUIC disabled until the patched running binary is verified.
# This template does not patch an installed NGINX package.
server {
    listen 80;
    server_name hazards.example.org;
    # npm run build:web places compiled Vue assets inside this public directory.
    root /var/www/munialert/hazard-server/public;
    index index.php;
    client_max_body_size 8m;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header X-Frame-Options SAMEORIGIN always;

    location = /index.php {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME /var/www/munialert/hazard-server/public/index.php;
        fastcgi_param SCRIPT_NAME /index.php;
        # Match the separately verified installed PHP-FPM version/socket.
        fastcgi_pass unix:/run/php/php8.5-fpm.sock;
        fastcgi_read_timeout 90s;
    }
    location / { try_files $uri $uri/ /index.php?$query_string; }
    location = /app/index.html { add_header Cache-Control no-store; }
    location ~ /\. { deny all; }
    location ~ \.php$ { return 404; }
}
