{
  "name": "bantay-integration",
  "private": true,
  "workspaces": [
    "hazard-client"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "api": "node hazard-server/scripts/serve.mjs",
    "build": "npm run build -w hazard-client",
    "typecheck": "npm run typecheck -w hazard-client",
    "test": "node scripts/php.mjs --cwd=hazard-server artisan test --no-ansi",
    "db:migrate": "node scripts/php.mjs hazard-server/artisan migrate",
    "db:seed": "node scripts/php.mjs hazard-server/artisan db:seed",
    "db:seed:accounts": "node scripts/php.mjs hazard-server/artisan db:seed --class=DemoAccountSeeder",
    "test:e2e": "node scripts/run-e2e.mjs",
    "verify": "node scripts/verify.mjs",
    "docs:build": "node scripts/build-docs.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "docs:pdf": "npm run docs:build && node scripts/export-docs-pdf.mjs",
    "build:web": "node scripts/package-web.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "concurrently": "^9.2.1",
    "markdown-it": "^14.3.1"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.7",
    "firebase": {
      "@grpc/grpc-js": "^1.14.7"
    }
  }
}
